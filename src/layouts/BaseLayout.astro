---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import {
  SUPPORTED_LANGUAGES,
  getCanonicalUrl,
  type LocaleCode,
} from '../i18n/translations';

interface Props {
  title: string;
  description: string;
  locale: LocaleCode;
  currentPage: '' | 'how-to-use/' | 'hire-me/';
}

const { title, description, locale, currentPage } = Astro.props;

const canonicalUrl = getCanonicalUrl(locale, currentPage);
const xDefaultUrl = getCanonicalUrl('en', currentPage);
const currentLangObj =
  SUPPORTED_LANGUAGES.find((l) => l.code === locale) || SUPPORTED_LANGUAGES[0];
const ogImageUrl = 'https://videothumbnail.github.io/og-image.png';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Anti-FOUC Theme Initialization Script -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (
            saved === 'dark' ||
            (!saved &&
              window.matchMedia &&
              window.matchMedia('(prefers-color-scheme: dark)').matches)
          ) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>

    <!-- GTM & GA4 Analytics -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtm.js?id=GTM-PFMBHLLL"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-FXH7YP2SCM');
    </script>

    <!-- Primary SEO Title & Description -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Kishara Dilshan" />

    <!-- Self-Referencing Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- 8-Language hreflang Alternates + x-default -->
    {
      SUPPORTED_LANGUAGES.map((lang) => (
        <link
          rel="alternate"
          hreflang={lang.code}
          href={getCanonicalUrl(lang.code, currentPage)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    <!-- Open Graph Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VideoThumbnail" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={currentLangObj.ogLocale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="VideoThumbnail - Extract high-resolution frames from MP4, MOV, or WebM videos and design YouTube thumbnails in your browser"
    />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- PWA & Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="192x192" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#C5D89D" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="VideoThumbnail" />

    <!-- JSON-LD Schema Slot -->
    <slot name="schema" />
  </head>
  <body class="min-h-screen flex flex-col bg-surface-page text-content-primary antialiased selection:bg-brand-sage selection:text-brand-ink">
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PFMBHLLL"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="GTM"
      ></iframe>
    </noscript>

    <Navbar locale={locale} currentPage={currentPage} />

    <slot name="breadcrumbs" />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer locale={locale} currentPage={currentPage} />

    <!-- Service Worker Registration for Offline PWA Support -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker
            .register('/sw.js')
            .catch(function () {});
        });
      }
    </script>
  </body>
</html>

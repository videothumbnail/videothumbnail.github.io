---
import HomePage from '../../components/pages/HomePage.astro';
import { NON_DEFAULT_LOCALES, type LocaleCode } from '../../i18n/translations';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
---

<HomePage locale={locale} />

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import {
  getCanonicalUrl,
  translations,
  type LocaleCode,
} from '../../i18n/translations';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const t = translations[locale];
const canonicalUrl = getCanonicalUrl(locale, 'hire-me/');

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kishara Dilshan',
  url: canonicalUrl,
  email: 'mailto:kisharadilshan007@gmail.com',
  jobTitle: 'Full-Stack Web & WebAssembly Developer',
  description: t.hireMe.metaDescription,
  knowsAbout: [
    'Astro',
    'React',
    'Next.js',
    'WebAssembly (WASM)',
    'Client-Side Browser Applications',
    'Technical SEO',
    'UI/UX Design',
  ],
  sameAs: [
    'https://github.com/videothumbnail/videothumbnail.github.io',
    'https://kisharadilshan.gumroad.com/coffee',
  ],
};
---

<BaseLayout
  title={t.hireMe.title}
  description={t.hireMe.metaDescription}
  locale={locale}
  currentPage="hire-me/"
>
  <Fragment slot="schema">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personSchema)}
    />
  </Fragment>

  <Breadcrumbs
    slot="breadcrumbs"
    locale={locale}
    currentPage="hire-me/"
    currentLabel={t.hireMe.breadcrumb}
  />

  <section
    aria-labelledby="hire-me-h1"
    class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8"
  >
    <div class="rounded-3xl border-2 border-line bg-surface-card p-6 shadow-elevated sm:p-10">
      <!-- Single H1 matching pages_metadata.hire_me.h1 & hire_me_exact_content.badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-moss/40 bg-brand-sage px-4 py-1.5 text-brand-ink">
        <span class="h-2.5 w-2.5 rounded-full bg-brand-ink animate-pulse"></span>
        <h1 id="hire-me-h1" class="text-sm font-extrabold tracking-wide">
          {t.hireMe.h1}
        </h1>
      </div>

      <!-- Display Heading -->
      <h2 class="mt-5 text-3xl font-extrabold tracking-tight text-content-primary sm:text-4xl lg:text-5xl">
        {t.hireMe.heading}
      </h2>

      <!-- Intro & Subcopy -->
      <p class="mt-4 text-lg font-bold text-content-primary">
        {t.hireMe.intro}
      </p>
      <p class="mt-2 text-base leading-relaxed text-content-secondary">
        {t.hireMe.subcopy}
      </p>

      <!-- 3 Specialties -->
      <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-3">
        {
          t.hireMe.specialties.map((spec, idx) => (
            <article class="flex flex-col rounded-2xl border border-line bg-surface-subtle/75 p-5 spring-transition hover:-translate-y-0.5">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-sage text-brand-ink font-extrabold text-sm">
                0{idx + 1}
              </span>
              <h3 class="mt-4 text-base font-extrabold text-content-primary">
                {spec.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-content-secondary">
                {spec.description}
              </p>
            </article>
          ))
        }
      </div>

      <!-- CTA Box with Direct Email & Working Copy Email Button -->
      <div class="mt-10 rounded-2xl border border-brand-moss/40 bg-brand-cream p-6 text-brand-ink sm:p-8">
        <h3 class="text-2xl font-extrabold tracking-tight">
          {t.hireMe.ctaHeading}
        </h3>

        <div class="mt-5 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
          <a
            href={`mailto:${t.hireMe.email}`}
            class="inline-flex items-center gap-2.5 text-base font-extrabold text-brand-ink underline-offset-4 hover:underline sm:text-lg break-all"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>{t.hireMe.emailLabel}</span>
          </a>

          <button
            type="button"
            id="copy-email-btn"
            data-email={t.hireMe.email}
            data-copy-label={t.hireMe.copyButtonLabel}
            data-copied-label={t.hireMe.copiedConfirmation}
            class="btn-sage inline-flex min-h-[48px] shrink-0 items-center gap-2 rounded-xl px-6 py-3 text-sm font-extrabold shadow-sm border border-brand-ink/15"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
            </svg>
            <span id="copy-email-text">{t.hireMe.copyButtonLabel}</span>
          </button>
        </div>

        <p
          id="copy-email-status"
          aria-live="polite"
          class="mt-3 hidden text-xs font-extrabold text-brand-ink"
        >
          {t.hireMe.copiedConfirmation}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const btn = document.getElementById('copy-email-btn');
    const textEl = document.getElementById('copy-email-text');
    const statusEl = document.getElementById('copy-email-status');
    if (!btn || !textEl) return;

    btn.addEventListener('click', function () {
      const email = btn.getAttribute('data-email') || 'kisharadilshan007@gmail.com';
      const copyLabel = btn.getAttribute('data-copy-label') || 'Copy Email';
      const copiedLabel = btn.getAttribute('data-copied-label') || 'Copied!';

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(email).catch(function () {});
      } else {
        const ta = document.createElement('textarea');
        ta.value = email;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }

      textEl.textContent = '✓ ' + copiedLabel;
      if (statusEl) statusEl.classList.remove('hidden');

      setTimeout(function () {
        textEl.textContent = copyLabel;
        if (statusEl) statusEl.classList.add('hidden');
      }, 2800);
    });
  })();
</script>

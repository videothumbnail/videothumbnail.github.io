---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import {
  getCanonicalUrl,
  getLocalizedPath,
  translations,
  type LocaleCode,
} from '../../i18n/translations';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const t = translations[locale];
const canonicalUrl = getCanonicalUrl(locale, 'how-to-use/');
const homeHref = getLocalizedPath(locale, '');

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: t.howToUse.h1,
  description: t.howToUse.metaDescription,
  totalTime: 'PT1M',
  estimatedCost: {
    '@type': 'MonetaryAmount',
    currency: 'USD',
    value: '0',
  },
  tool: [
    {
      '@type': 'HowToTool',
      name: 'VideoThumbnail Browser Studio (HTML5 Video & Canvas 2D)',
    },
  ],
  step: t.howToUse.steps.map((s, idx) => ({
    '@type': 'HowToStep',
    position: idx + 1,
    name: s.name,
    text: s.text,
    url: `${canonicalUrl}#step-${idx + 1}`,
  })),
};
---

<BaseLayout
  title={t.howToUse.title}
  description={t.howToUse.metaDescription}
  locale={locale}
  currentPage="how-to-use/"
>
  <Fragment slot="schema">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(howToSchema)}
    />
  </Fragment>

  <Breadcrumbs
    slot="breadcrumbs"
    locale={locale}
    currentPage="how-to-use/"
    currentLabel={t.howToUse.breadcrumb}
  />

  <section
    aria-labelledby="howto-heading"
    class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8"
  >
    <div class="rounded-3xl border border-line bg-surface-card p-6 shadow-card sm:p-10">
      <h1
        id="howto-heading"
        class="text-3xl font-extrabold tracking-tight text-content-primary sm:text-4xl"
      >
        {t.howToUse.h1}
      </h1>
      <p class="mt-4 text-base leading-relaxed text-content-secondary sm:text-lg">
        {t.howToUse.intro}
      </p>

      <!-- 4-Step Guide Cards -->
      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          t.howToUse.steps.map((step, index) => (
            <article
              id={`step-${index + 1}`}
              class="flex flex-col rounded-2xl border border-line bg-surface-subtle/65 p-6"
            >
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-sage text-brand-ink font-extrabold text-base">
                  {index + 1}
                </span>
                <h2 class="text-lg font-extrabold text-content-primary">
                  {step.name}
                </h2>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-content-secondary">
                {step.text}
              </p>
            </article>
          ))
        }
      </div>

      <!-- Deep-Dive Best Practices Sections -->
      <div class="mt-10 space-y-6 border-t border-line pt-8">
        {
          t.howToUse.sections.map((sec) => (
            <article class="rounded-2xl border border-line bg-surface-page p-6">
              <h2 class="text-xl font-extrabold text-content-primary">
                {sec.heading}
              </h2>
              <p class="mt-2.5 text-sm leading-relaxed text-content-secondary sm:text-base">
                {sec.body}
              </p>
            </article>
          ))
        }
      </div>

      <!-- Call to Action back to the Tool -->
      <div class="mt-10 flex flex-col items-center justify-between gap-4 rounded-2xl bg-brand-cream p-6 text-brand-ink sm:flex-row border border-brand-moss/30">
        <p class="text-base font-extrabold">{t.howToUse.ctaText}</p>
        <a
          href={homeHref}
          class="btn-sage inline-flex min-h-[48px] shrink-0 items-center gap-2 rounded-xl px-6 py-3 text-sm font-extrabold shadow-sm"
        >
          <span>{t.howToUse.ctaBtn}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.3"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
